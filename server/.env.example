# Copiá este archivo a server/.env y completá los valores reales.
# server/.env NO se commitea (está en .gitignore).

# Connection string del proyecto de base de datos en Neon.
# La sacás de: Neon Console -> tu proyecto -> Connection Details -> "Connection string".
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Puerto local del server (Render lo inyecta solo en producción).
PORT=3000
