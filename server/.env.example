# Copia este archivo a server/.env y completa los valores reales.
# server/.env NO se commitea (esta en .gitignore).

# Connection string de Postgres.
#  - Local: usa un BRANCH de desarrollo en Neon (Neon Console -> Branches ->
#    New branch) para no tocar la base que usa el deploy. Copia su connection
#    string desde Connection Details.
#  - En Render (comunero-server) esta variable se carga a mano en el dashboard,
#    nunca en el repo.
# Formato: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Puerto local del server (Render lo inyecta solo en produccion).
PORT=3000
