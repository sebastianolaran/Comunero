// Schema de Prisma para el server de Comunero: modelo de dominio completo.
// Reemplaza la tabla HealthCheck del bootstrap, que ya no se usa: el endpoint
// /api/health/db verifica la conexion con un SELECT 1, no contra una tabla.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ReservationType {
  USE
  RENTAL
}

enum ReservationStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

enum MovementType {
  EXPENSE
  INCOME
}

enum DecisionStatus {
  OPEN
  APPROVED
  REJECTED
}

enum VoteValue {
  YES
  NO
}

enum RenterRating {
  RECOMMENDED
  NOT_RECOMMENDED
}

// ---------- Modelos ----------

model Asset {
  id   String @id @default(cuid())
  name String

  users        User[]
  reservations Reservation[]
  renters      Renter[]
  movements    Movement[]
  settlements  Settlement[]
  decisions    Decision[]
  activityLogs ActivityLog[]
}

model User {
  id           String @id @default(cuid())
  assetId      String
  name         String
  // Solo dígitos, con código de país incluido (ej: 5491122334455). Sin
  // guiones, espacios ni el signo "+". Se normaliza antes de guardar.
  phone        String @unique
  passwordHash String

  asset Asset @relation(fields: [assetId], references: [id])

  reservations         Reservation[]
  objections           Objection[]
  movementsPaid        Movement[]            @relation("MovementPaidBy")
  movementShares       MovementShare[]
  settlementsFrom      Settlement[]          @relation("SettlementFrom")
  settlementsTo        Settlement[]          @relation("SettlementTo")
  decisionsRaised      Decision[]            @relation("DecisionProposedBy")
  votes                Vote[]
  activityLogs         ActivityLog[]
  renterObservations   RenterObservation[]
  reservationApprovals ReservationApproval[]
  assignedRentalTasks  RentalTask[]

  @@index([assetId])
}

model Reservation {
  id              String            @id @default(cuid())
  assetId         String
  userId          String
  // Solo se completa cuando type = RENTAL.
  renterId        String?
  startDate       DateTime
  endDate         DateTime
  type            ReservationType
  status          ReservationStatus @default(PENDING)
  note            String?
  // Monto total pactado con el inquilino (solo aplica a RENTAL).
  amount          Int?
  // Solo RENTAL. null = pago pendiente; una vez cargado no se vuelve atrás.
  // El cobro queda registrado como un Movement (type=INCOME) con reservationId.
  paidAt          DateTime?
  // Motivo que pone el sistema al rechazarla (ej. solapamiento con un alquiler
  // aprobado). Los rechazos de los copropietarios van en Objection.
  rejectionReason String?
  createdAt       DateTime          @default(now())

  asset        Asset                 @relation(fields: [assetId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  renter       Renter?               @relation(fields: [renterId], references: [id])
  objections   Objection[]
  observations RenterObservation[]
  approvals    ReservationApproval[]
  movements    Movement[]
  tasks        RentalTask[]

  @@index([assetId])
  @@index([userId])
  @@index([renterId])
}

model ReservationApproval {
  reservationId String
  userId        String
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@id([reservationId, userId])
}

model Objection {
  id            String   @id @default(cuid())
  reservationId String
  userId        String
  // Opcional: se puede rechazar sin dar motivo.
  reason        String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([reservationId])
}

model Renter {
  id      String        @id @default(cuid())
  assetId String
  name    String
  phone   String
  // null = sin definir: todavia nadie lo clasifico.
  rating  RenterRating?

  asset        Asset               @relation(fields: [assetId], references: [id])
  reservations Reservation[]
  observations RenterObservation[]

  @@index([assetId])
}

model RenterObservation {
  id            String   @id @default(cuid())
  renterId      String
  // Opcional: una observacion es sobre el inquilino, no sobre un alquiler puntual.
  reservationId String?
  authorId      String
  text          String
  createdAt     DateTime @default(now())

  renter      Renter       @relation(fields: [renterId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])

  @@index([renterId])
  @@index([reservationId])
}

model RentalTask {
  id            String    @id @default(cuid())
  reservationId String
  assignedToId  String
  name          String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  assignedTo  User        @relation(fields: [assignedToId], references: [id])

  @@index([reservationId])
  @@index([assignedToId])
}

model Movement {
  id            String       @id @default(cuid())
  assetId       String
  reservationId String?
  type          MovementType
  amount        Int
  description   String
  date          DateTime
  paidById      String

  asset       Asset           @relation(fields: [assetId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  paidBy      User            @relation("MovementPaidBy", fields: [paidById], references: [id])
  shares      MovementShare[]

  @@index([assetId])
  @@index([reservationId])
}

model MovementShare {
  movementId String
  userId     String

  movement Movement @relation(fields: [movementId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([movementId, userId])
}

model Settlement {
  id         String   @id @default(cuid())
  assetId    String
  fromUserId String
  toUserId   String
  amount     Int
  date       DateTime

  asset    Asset @relation(fields: [assetId], references: [id])
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([assetId])
}

model Decision {
  id           String         @id @default(cuid())
  assetId      String
  title        String
  description  String
  proposedById String
  status       DecisionStatus @default(OPEN)
  createdAt    DateTime       @default(now())
  closedAt     DateTime?

  asset      Asset  @relation(fields: [assetId], references: [id])
  proposedBy User   @relation("DecisionProposedBy", fields: [proposedById], references: [id])
  votes      Vote[]

  @@index([assetId])
}

model Vote {
  decisionId String
  userId     String
  value      VoteValue

  decision Decision @relation(fields: [decisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([decisionId, userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([assetId])
}
