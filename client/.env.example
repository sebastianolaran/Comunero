# Copia este archivo a client/.env y completa el valor real.
# client/.env NO se commitea.

# URL base del backend (server de Express).
#  - Local: http://localhost:3000
#  - En Render: la inyecta el Blueprint (render.yaml) desde el web service,
#    o se carga a mano en el static site comunero-client.
# Vite solo expone variables con prefijo VITE_ y las resuelve en build time.
VITE_API_URL=http://localhost:3000

# Id del bien (Asset) cuyas solicitudes de alquiler se muestran. Temporal:
# se reemplaza por el bien del usuario logueado cuando exista el login.
# Con el seed del server (npm run seed) se imprime el id a usar.
VITE_DEMO_ASSET_ID=
